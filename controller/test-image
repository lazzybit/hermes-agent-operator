#!/bin/sh
# Smoke-test the controller image entrypoint.
set -eu

if [ -z "${IMAGE:-}" ]; then
	echo "test-image: IMAGE is required" >&2
	exit 64
fi

docker run --rm "$IMAGE" --help
docker run --rm --entrypoint /opt/telegram/bin/python -v "$(pwd)/controller/test_telegram_provision.py:/test_telegram_provision.py:ro" "$IMAGE" /test_telegram_provision.py
