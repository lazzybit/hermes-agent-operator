FROM golang:1.24.13 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /manager .
FROM python:3.13-slim
RUN python -m venv /opt/telegram && /opt/telegram/bin/pip install --no-cache-dir telethon==1.45.0
COPY telegram_provision.py /telegram_provision.py
COPY --from=builder /manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
