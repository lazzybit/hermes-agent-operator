# Official Hermes agent plus /usr/local/bin/hermes-gateway-init.
# The upstream Docker entrypoint and hermes launcher are unchanged.
# Official startup unsets PYTHONPATH and loads extra paths only via
# site.addsitedir(HERMES_SITE), so this image ships a static .pth that
# points at /run/hermes/generated/plugin-deps. hermes-plugin-path
# materializes operator plugin-deps there, then execs official hermes.
# Kubernetes overrides the gateway container command and invokes the
# init entry only from the init container.
# A custom image that does not provide this entry cannot perform home,
# config, credential, or plugin integration.
FROM golang:1.24.13 AS builder
WORKDIR /src
COPY go.mod ./
COPY *.go ./
RUN CGO_ENABLED=0 go build -trimpath -o /hermes-gateway-init .

FROM nousresearch/hermes-agent:v0.23.0@sha256:adb7890916de63245523492be8f68f9d2095fecbec4e2a6dab7960381f0fc002
USER root
COPY patches/ssh-media-session.patch /tmp/ssh-media-session.patch
RUN cd /opt/hermes \
 && git apply --check /tmp/ssh-media-session.patch \
 && git apply /tmp/ssh-media-session.patch \
 && rm /tmp/ssh-media-session.patch
COPY --from=builder /hermes-gateway-init /usr/local/bin/hermes-gateway-init
COPY hermes-plugin-path /usr/local/bin/hermes-plugin-path
RUN chmod 0755 /usr/local/bin/hermes-gateway-init /usr/local/bin/hermes-plugin-path \
 && site="$(/opt/hermes/.venv/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')" \
 && printf '%s\n' '/run/hermes/generated/plugin-deps' > "$site/hermes-plugin-deps.pth"
USER 10000:10000
