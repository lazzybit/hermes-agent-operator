#!/bin/sh
# Materialize operator-injected plugin dependency directories under
# /run/hermes/generated/plugin-deps, then exec the official launcher.
# That launcher unsets PYTHONPATH and loads extra paths only through
# site.addsitedir(HERMES_SITE), which reads the image's static .pth
# pointing at this generated directory.
set -eu

if [ "$#" -eq 0 ]; then
	echo "hermes-plugin-path: missing command" >&2
	exit 64
fi

dest=/run/hermes/generated/plugin-deps
python="${HERMES_PYTHON:-/opt/hermes/.venv/bin/python}"

"$python" - "$dest" << 'PY'
import os
import pathlib
import sys

dest = pathlib.Path(sys.argv[1])
dest.mkdir(parents=True, exist_ok=True)
for child in dest.iterdir():
    if child.is_symlink() or child.is_file():
        child.unlink()

skip = {"sitecustomize.py", "__pycache__"}
for part in os.environ.get("PYTHONPATH", "").split(os.pathsep):
    if not part:
        continue
    src = pathlib.Path(part)
    if not src.is_dir():
        continue
    for item in src.iterdir():
        if item.name in skip or item.suffix == ".pth":
            continue
        target = dest / item.name
        if not target.exists():
            target.symlink_to(item)
PY

exec "$@"
